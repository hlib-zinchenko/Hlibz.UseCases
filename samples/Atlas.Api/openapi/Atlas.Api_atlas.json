{
  "openapi": "3.2.0",
  "info": {
    "title": "Atlas.Api | atlas",
    "version": "1.0.0"
  },
  "paths": {
    "/api/cities": {
      "post": {
        "tags": [
          "Cities"
        ],
        "summary": "Adds a city.",
        "description": "Adds a city to a country and returns it, with its new id.",
        "operationId": "CreateCity",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCityCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityDto"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request didn't pass validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cities/{id}": {
      "get": {
        "tags": [
          "Cities"
        ],
        "summary": "Gets a city.",
        "description": "Gets one city by its id.",
        "operationId": "GetCity",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The city's id.",
            "required": true,
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request didn't pass validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CityDto": {
        "required": [
          "id",
          "name",
          "countryCode",
          "population"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The city's id.",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "Its name."
          },
          "countryCode": {
            "type": "string",
            "description": "Its country's ISO code."
          },
          "population": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many people live there.",
            "format": "int32"
          }
        },
        "description": "A city."
      },
      "CreateCityCommand": {
        "required": [
          "name",
          "countryCode",
          "population",
          "districts"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 60,
            "type": "string",
            "description": "The city's name, as it's written locally."
          },
          "countryCode": {
            "pattern": "^[A-Z]{2}$",
            "type": "string",
            "description": "The country's ISO code.\n\nA two-letter ISO 3166 country code in capitals, such as UA.",
            "x-rules": [
              "A two-letter ISO 3166 country code in capitals, such as UA."
            ]
          },
          "population": {
            "maximum": 50000000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many people live there.",
            "format": "int32"
          },
          "districts": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/District"
            },
            "description": "Its districts, if any."
          }
        },
        "description": "Adds a city to a country.\n\nName must be unique within the country.",
        "x-rules": [
          "Name must be unique within the country."
        ]
      },
      "District": {
        "required": [
          "name",
          "population"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The district's name."
          },
          "population": {
            "maximum": 10000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many people live there.",
            "format": "int32"
          }
        },
        "description": "A district of a city."
      },
      "ErrorResponse": {
        "required": [
          "message",
          "code"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "validationErrors": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cities"
    }
  ]
}