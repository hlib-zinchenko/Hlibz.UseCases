<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="NuGet metadata">
    <PackageId>Hlibz.UseCases</PackageId>
    <Description>Use cases for .NET apps with several clients (HTTP endpoints, MCP tools, gRPC services, jobs): a record implementing IUseCase, a handler implementing IUseCaseHandler&lt;TUseCase, TResult, TError&gt; and returning Hlibz.Results' Result&lt;TResult, TError&gt; (the value, or one of the errors it declares, a C# union of error types), and every client injecting the handler's own interface. A source generator lists the handlers at compile time (no assembly scan) and wraps each one in a pipeline that validates the use case against its DataAnnotations first, the same rules ASP.NET Core's validation applies (nested records, collections, record parameter attributes, IValidatableObject), with no ASP.NET Core dependency, then runs your own filters. Custom validation attributes can describe themselves (IDescribedRule, [RuleSummary]) for OpenAPI or tool schemas to publish.</Description>
    <PackageTags>use-cases;clean-architecture;cqrs;handlers;validation;data-annotations;source-generator;mcp;grpc</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
      The Microsoft.Extensions abstractions it uses (dependency injection, options) are part of
      .NET 11's shared framework: no package references (NU1510).
  -->
  <ItemGroup>
    <PackageReference Include="Hlibz.Results" />
  </ItemGroup>

  <!--
      The source generator ships inside this package (analyzers/dotnet/cs), plus a buildTransitive
      target that adds it to a project referencing the package indirectly if the SDK hasn't.
      Built first, never a dependency of its own.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Hlibz.UseCases.Generators\Hlibz.UseCases.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="..\Hlibz.UseCases.Generators\bin\$(Configuration)\netstandard2.0\Hlibz.UseCases.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="buildTransitive\Hlibz.UseCases.targets"
          Pack="true"
          PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hlibz.UseCases.Tests" />
  </ItemGroup>

</Project>
