<Project Sdk="Microsoft.NET.Sdk">

  <!--
      The source generator behind AddUseCases: lists every handler of the assembly it runs on in a
      UseCaseManifestAttribute, wraps each one in a pipeline that implements the handler's own
      interface, writes the validation tables of the types its use cases reach, and reports a
      handler it can't register as a build error. Not a package of its own: Hlibz.UseCases ships it
      under analyzers/dotnet/cs. netstandard2.0 and Roslyn 4.8, a low minimum, so every SDK
      loads it.
  -->
  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- netstandard2.0 defaults to C# 7.3; pinned rather than "latest" so the build doesn't change with the SDK. -->
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hlibz.UseCases.Generators.Tests" />
  </ItemGroup>

</Project>
