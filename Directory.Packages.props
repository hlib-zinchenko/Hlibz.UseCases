<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- A minimum: packed as ">= 3.0.0", so an app picks any newer 3.x itself. -->
        <PackageVersion Include="Hlibz.Results" Version="3.0.0-preview.2" />
        <!-- Samples only: Atlas.Api sends the use cases' results as HTTP responses. -->
        <PackageVersion Include="Hlibz.Results.AspNetCore" Version="3.0.0-preview.2" />
        <!--
            The Microsoft.Extensions abstractions, both minimums (Dependabot ignores them).
            Microsoft.Extensions.DependencyInjection and Microsoft.Extensions.Validation are
            test-only: the container the tests resolve from, and the engine the parity tests
            compare the generated validation with.
        -->
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Validation" Version="11.0.0" />
        <!--
            The Roslyn the source generator builds against, and so the oldest compiler that can
            load it: a deliberately low minimum (4.8), far below the .NET 11 SDK's, so every SDK
            that builds the package's consumers loads it. Raise it only when the generator needs a
            newer Roslyn API (Dependabot ignores it).
        -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>
</Project>
